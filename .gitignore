# =============================================================================
# Steam Cracker Coil Health Monitoring — .gitignore
# =============================================================================

# --- Data files --------------------------------------------------------------
# Raw and converted data files are NOT committed — they are too large for
# version control and contain proprietary experimental data.
# See README Section 4 for data acquisition and conversion instructions.
data.xlsx
*.xlsb
*.xls
*.csv

# --- Generated outputs -------------------------------------------------------
# All outputs are reproducible by running the pipeline. Do not commit them —
# keeping them out ensures the pipeline is always exercised on a fresh clone.
prepared_data/
results/
figures/

# --- Python environment ------------------------------------------------------
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg

# --- Jupyter -----------------------------------------------------------------
.ipynb_checkpoints/
*.ipynb

# --- IDE and OS --------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# --- Logs and temp files -----------------------------------------------------
*.log
*.tmp
*.bak
main_local.py
